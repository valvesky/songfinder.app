{
  "manifest_version": 3,
  "name": "findSong.app",
  "version": "0.2.0",
  "description": "Find the song playing in any video. Outlines the video, listens for 10 seconds, names the track.",
  "permissions": ["activeTab", "webNavigation"],
  "host_permissions": ["https://amp.shazam.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "findSong.app", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/shazam.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
